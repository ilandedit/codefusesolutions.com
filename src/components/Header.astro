---
interface Props {
  showWork?: boolean;
}
const { showWork = false } = Astro.props;
---

<header>
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="CodeFuse Solutions — home">
      CodeFuse<span class="wordmark-tail">&nbsp;Solutions</span>
    </a>
    <nav aria-label="Main">
      {showWork && <a class="nav-link label" href="/#work">Work</a>}
      <a class="nav-link label" href="/#method">Method</a>
      <a class="nav-link label" href="/#studio">Studio</a>
      <a class="misfit misfit-compact" href="/#contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
    border-bottom: 1px solid var(--gridline);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.625rem;
  }

  .wordmark-tail {
    font-family: var(--font-text);
    font-weight: 400;
    font-size: 1.0625rem;
    color: var(--slate);
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.25rem);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--slate);
    text-decoration: none;
    transition: color 160ms ease-out;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  @media (max-width: 480px) {
    .wordmark-tail {
      display: none;
    }
  }
</style>
