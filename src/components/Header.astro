---
import { getCollection } from 'astro:content';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

// Don't advertise Work until there is work: in production the samples are
// filtered out, so the link would lead to an empty room.
const work = (await getCollection('work')).filter(
  (entry) => !(import.meta.env.PROD && entry.data.sample)
);

const links = [
  ...(work.length > 0 ? [{ href: '/work/', label: 'Work' }] : []),
  { href: '/studio/', label: 'Studio' },
];
---

<header data-header>
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="CodeFuse Solutions — home">
      CodeFuse<span class="tail">&nbsp;Solutions</span>
    </a>
    <nav aria-label="Main">
      {
        links.map((l) => (
          <a
            class:list={['nav-link', 'small', { current: isCurrent(l.href) }]}
            href={l.href}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <a
        class="btn nav-btn"
        href="/contact/"
        aria-current={isCurrent('/contact/') ? 'page' : undefined}
      >
        Contact
      </a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 9;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.2s var(--ease);
  }

  header.scrolled {
    box-shadow: 0 6px 20px rgba(16, 26, 46, 0.06);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
    padding-block: 0.5rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3125rem;
    color: var(--navy);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .tail {
    font-family: var(--font-text);
    font-weight: 400;
    font-size: 1rem;
    color: var(--mute);
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--mute);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.current {
    color: var(--ink);
    border-bottom-color: var(--copper);
  }

  .nav-btn {
    padding: 0.625rem 1.125rem;
    min-height: 40px;
    font-size: 0.875rem;
  }

  @media (max-width: 520px) {
    .tail {
      display: none;
    }
  }
</style>
