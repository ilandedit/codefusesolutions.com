---
interface Props {
  showWork?: boolean;
}
const { showWork = false } = Astro.props;
---

<header>
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="CodeFuse Solutions — home">
      <svg class="mark" width="26" height="16" viewBox="0 0 26 16" aria-hidden="true">
        <g fill="currentColor">
          <rect x="0" y="0" width="2" height="16"></rect>
          <rect x="4" y="0" width="1" height="16"></rect>
          <rect x="7" y="0" width="3" height="16"></rect>
          <rect x="12" y="0" width="1" height="16"></rect>
          <rect x="15" y="0" width="2" height="16"></rect>
          <rect x="19" y="0" width="1" height="16"></rect>
          <rect x="22" y="0" width="4" height="16"></rect>
        </g>
      </svg>
      <span class="label">CodeFuse Solutions</span>
    </a>
    <nav aria-label="Main">
      {showWork && <a class="label" href="/#work">Work</a>}
      <a class="label" href="/#method">Method</a>
      <a class="label" href="/#studio">Studio</a>
      <a class="label nav-contact" href="/#contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--void);
    border-bottom: 1px solid var(--hairline);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--pulse);
    text-decoration: none;
    padding-block: 0.75rem;
  }

  .mark {
    display: block;
  }

  nav {
    display: flex;
    align-items: stretch;
    gap: clamp(1rem, 3vw, 2.25rem);
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--industrial);
    text-decoration: none;
    transition: color 120ms linear;
  }

  nav a:hover {
    color: var(--pulse);
  }

  .nav-contact {
    color: var(--code-contact);
  }

  .nav-contact:hover {
    color: var(--pulse);
  }

  @media (max-width: 480px) {
    .wordmark .label {
      display: none;
    }
  }
</style>
