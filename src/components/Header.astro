---
import { getCollection } from 'astro:content';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

// Don't advertise Work unless there is something to show there.
const work = await getCollection('work');

// The wordmark sits in the middle with the links split either side of it.
const left = [
  { href: '/', label: 'Home' },
  ...(work.length > 0 ? [{ href: '/work/', label: 'Work' }] : []),
];
const right = [
  { href: '/studio/', label: 'Studio' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="site-head">
  <a class="wordmark" href="/" aria-label="CodeFuse Solutions — home">
    CodeFuse Solutions
  </a>
  <nav class="nav nav-left" aria-label="Main">
    {
      left.map((l) => (
        <a
          class:list={['nav-link', { current: isCurrent(l.href) }]}
          href={l.href}
          aria-current={isCurrent(l.href) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))
    }
  </nav>
  <nav class="nav nav-right" aria-label="Main, continued">
    {
      right.map((l) => (
        <a
          class:list={['nav-link', { current: isCurrent(l.href) }]}
          href={l.href}
          aria-current={isCurrent(l.href) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'left mark right';
    align-items: center;
    gap: 1.5rem;
    padding: clamp(2rem, 7vh, 3.75rem) clamp(1.25rem, 3vw, 2.75rem);
  }

  .wordmark {
    grid-area: mark;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.125rem, 1.75vw, 1.5625rem);
    line-height: 1;
    letter-spacing: 0.15em;
    /* Tracking adds trailing space; pull it back so the mark centres. */
    margin-right: -0.15em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 1.7vw, 1.5rem);
  }

  .nav-left {
    grid-area: left;
    justify-content: flex-start;
  }

  .nav-right {
    grid-area: right;
    justify-content: flex-end;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
    text-decoration: none;
    transition: color 0.18s var(--ease);
  }

  .nav-link:hover,
  .nav-link.current {
    color: var(--ink);
  }

  .nav-link.current {
    font-weight: 600;
  }

  /* Small screens: the mark on its own line, all four links in a row under
     it. Four short links fit, so there is no menu to open. */
  @media (max-width: 760px) {
    .site-head {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'mark mark'
        'left right';
      row-gap: 0.75rem;
      column-gap: clamp(1rem, 5vw, 1.5rem);
      padding-block: 1.5rem 1rem;
    }

    .wordmark {
      justify-self: center;
    }

    .nav {
      gap: clamp(1rem, 5vw, 1.5rem);
    }

    .nav-left {
      justify-content: flex-end;
    }

    .nav-right {
      justify-content: flex-start;
    }
  }
</style>
