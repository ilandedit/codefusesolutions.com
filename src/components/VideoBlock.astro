---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  poster?: ImageMetadata;
  caption?: string;
  autoplay?: boolean;
}

const { src, poster, caption, autoplay = false } = Astro.props;

// The poster goes through the image pipeline like any other screenshot.
const posterUrl = poster
  ? (await getImage({ src: poster, width: 1600, format: 'webp', quality: 78 })).src
  : undefined;
---

<figure class="video-figure">
  <video
    class="demo"
    src={src}
    poster={posterUrl}
    controls={!autoplay}
    autoplay={autoplay}
    loop={autoplay}
    muted={autoplay}
    playsinline
    preload="metadata"
    data-autoplay={autoplay ? 'true' : undefined}
  >
    <p class="body-copy">
      Your browser can&rsquo;t play this video.
      <a class="text-link" href={src}>Download the recording</a> instead.
    </p>
  </video>
  {caption && <figcaption class="small">{caption}</figcaption>}
</figure>

{
  autoplay && (
    <script>
      // Autoplay loops only while on screen, and never under reduced motion.
      const quiet = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document
        .querySelectorAll<HTMLVideoElement>('video[data-autoplay]')
        .forEach((v) => {
          if (quiet) {
            v.removeAttribute('autoplay');
            v.controls = true;
            return;
          }
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) v.play().catch(() => {});
                else v.pause();
              }
            },
            { threshold: 0.25 }
          );
          io.observe(v);
        });
    </script>
  )
}

<style>
  .video-figure {
    margin: 2.5rem 0;
    width: min(100%, var(--max));
  }

  .demo {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--ink);
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--mute);
  }

  @media (min-width: 1100px) {
    .video-figure {
      width: calc(100% + 8rem);
      margin-inline: -4rem;
    }
  }
</style>
