---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Heading level for the title: h2 on the work index, h3 under a section. */
  level?: 'h2' | 'h3';
}

const { entry, level: Heading = 'h3' } = Astro.props;
const { data } = entry;
---

<a class="tile" href={`/work/${entry.id}/`} data-reveal>
  <span class:list={['shot', { blank: !data.cover }]}>
    {
      data.cover ? (
        <Image
          src={data.cover}
          alt=""
          widths={[480, 800, 1200]}
          sizes="(max-width: 820px) 100vw, 560px"
          format="webp"
          quality={74}
          loading="lazy"
        />
      ) : (
        // No screenshot yet: the tile holds its place with the project's name.
        <span class="blank-name" aria-hidden="true">
          {data.title}
        </span>
      )
    }
  </span>
  <p class="label tag">
    {data.client ?? 'Case study'}
    {data.year && ` · ${data.year}`}
    {data.sample && <span class="sample">Sample</span>}
  </p>
  <Heading class="title">{data.title}</Heading>
  <p class="summary">{data.summary}</p>
  <span class="label view">Read the case study &rarr;</span>
</a>

<style>
  .tile {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
  }

  .shot {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin-bottom: 1rem;
    background: #fff;
    border: 1px solid var(--line);
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.5s var(--ease);
  }

  .tile:hover .shot :global(img) {
    transform: scale(1.03);
  }

  .blank {
    display: grid;
    place-items: center;
    padding: 1.5rem;
    border: 0;
    background: linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 100%);
  }

  .blank-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-align: center;
    color: #fff;
  }

  .sample {
    display: inline-block;
    margin-left: 0.625rem;
    padding: 0 0.5rem;
    border: 1px solid var(--line);
    color: var(--mute);
  }

  .summary {
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 52ch;
  }

  .view {
    margin-top: 0.25rem;
    color: var(--ink);
    font-size: 0.75rem;
    transition: color 0.18s var(--ease);
  }

  .tile:hover .view,
  .tile:hover .title {
    color: var(--copper-deep);
  }

  .title {
    transition: color 0.18s var(--ease);
  }
</style>
