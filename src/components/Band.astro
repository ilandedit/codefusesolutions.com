---
import Panel from './Panel.astro';

interface Props {
  heading: string;
  copy: string;
  cta: string;
  href: string;
}
const { heading, copy, cta, href } = Astro.props;
---

<Panel center>
  <h2 class="display band-heading" data-reveal>{heading}</h2>
  <p data-reveal>{copy}</p>
  <a class="btn btn-invert" href={href} data-reveal>{cta}</a>
</Panel>

<style>
  .band-heading {
    font-size: clamp(2rem, 4.6vw, 3.75rem);
    max-width: 18ch;
  }
</style>
