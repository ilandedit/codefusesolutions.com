---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Lead images load eagerly; everything below the fold stays lazy. */
  eager?: boolean;
  /** Break out wider than the reading column. */
  wide?: boolean;
}

const { src, alt, caption, eager = false, wide = false } = Astro.props;
---

<figure class:list={['figure', { wide }]}>
  <Image
    src={src}
    alt={alt}
    widths={[640, 1024, 1600]}
    sizes="(max-width: 820px) 100vw, min(1140px, 92vw)"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    format="webp"
    quality={80}
  />
  {caption && <figcaption class="small">{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 2.5rem 0;
  }

  .figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--card);
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--mute);
  }

  /* Screenshots earn more width than the text column. */
  .wide {
    width: min(100%, var(--max));
  }

  @media (min-width: 1100px) {
    .wide {
      width: calc(100% + 8rem);
      margin-inline: -4rem;
    }
  }
</style>
