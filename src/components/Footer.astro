---
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap bar small">
    <p>© {year} CodeFuse Solutions · Founded and run by Derrick Wengerd</p>
    <nav aria-label="Footer">
      <a class="text-link" href="/studio/">Studio</a>
      <a class="text-link" href="mailto:contact@codefusesolutions.com?subject=Project%20inquiry">
        contact@codefusesolutions.com
      </a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding-block: 2rem;
    color: var(--mute);
  }

  nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
</style>
