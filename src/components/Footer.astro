---
const year = new Date().getFullYear();
---

<footer>
  <a class="mail" href="mailto:codefusesolutions@protonmail.com?subject=Project%20inquiry">
    codefusesolutions@protonmail.com
  </a>
  <p class="label legal">
    © {year} CodeFuse Solutions · Founded and run by Derrick Wengerd
  </p>
</footer>

<style>
  footer {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
    padding: clamp(3.5rem, 10vh, 5.5rem) var(--gutter);
  }

  .mail {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1rem, 2.2vw, 1.375rem);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
    overflow-wrap: anywhere;
    transition:
      color 0.18s var(--ease),
      border-color 0.18s var(--ease);
  }

  .mail:hover {
    color: var(--copper-deep);
    border-color: var(--copper-deep);
  }

  .legal {
    color: var(--ink);
    font-size: 0.75rem;
  }
</style>
