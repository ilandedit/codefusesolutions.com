---
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap bar small">
    <p>© {year} CodeFuse Solutions</p>
    <a class="text-link" href="mailto:contact@codefusesolutions.com?subject=Project%20inquiry">contact@codefusesolutions.com</a>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--gridline);
  }

  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding-block: 2rem;
    color: var(--slate);
  }

  a {
    font-size: 0.875rem;
  }
</style>
