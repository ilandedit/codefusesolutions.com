---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Band from '../../components/Band.astro';
import { Image } from 'astro:assets';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);
const hasSamples = work.some((e) => e.data.sample);
---

<Base
  title="Work — CodeFuse Solutions"
  description="Case studies from CodeFuse Solutions: custom systems built for businesses whose problems didn't fit off-the-shelf software."
>
  <Header />

  <main>
    <section class="wrap page-head">
      <p class="label">Work</p>
      <h1 class="display">Systems built to fit.</h1>
      <p class="lede">
        Every engagement starts with a problem that off-the-shelf software
        couldn&rsquo;t solve. Here&rsquo;s what that has looked like in
        practice.
      </p>
    </section>

    <section class="wrap section">
      {
        hasSamples && (
          <p class="section-note dev-note">
            Entries marked <strong>Sample</strong> are illustrative — they show
            the kind of work we take on and how we write about it, not real
            client engagements.
          </p>
        )
      }

      {
        work.length > 0 ? (
          <ul class="work-list">
            {work.map((entry) => (
              <li data-reveal>
                <a class="row" href={`/work/${entry.id}/`}>
                  {entry.data.cover && (
                    <span class="thumb">
                      <Image
                        src={entry.data.cover}
                        alt=""
                        widths={[280, 560]}
                        sizes="(max-width: 640px) 100vw, 280px"
                        format="webp"
                        quality={72}
                        loading="lazy"
                      />
                    </span>
                  )}
                  <div class="row-main">
                    <p class="label row-tag">
                      {entry.data.client ?? 'Case study'}
                      {entry.data.year && ` · ${entry.data.year}`}
                      {entry.data.sample && <span class="sample">Sample</span>}
                    </p>
                    <h2 class="headline row-title">{entry.data.title}</h2>
                    <p class="body-copy">{entry.data.summary}</p>
                  </div>
                  <span class="row-go" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty">
            <h2 class="title">Our first commercial product is in build.</h2>
            <p class="body-copy">
              We publish a case study when the work is finished and the client
              is happy for us to talk about it — not before. Nothing here is
              padded with stock imagery or invented numbers, which is the same
              standard we&rsquo;d hold your project to.
            </p>
            <p class="body-copy">
              In the meantime the fastest way to judge us is to talk to us.
              Ask what we&rsquo;re building and you&rsquo;ll get a walkthrough
              of the real thing — the problem it solves, how it&rsquo;s put
              together, and what we got wrong on the way.
            </p>
            <a class="btn" href="/contact/">Ask what we're building</a>
          </div>
        )
      }
    </section>
  </main>

  <Band
    heading="Could your problem be next?"
    copy="Tell us what you're up against. We'll tell you honestly whether we're the right studio for it."
    cta="Get in touch"
    href="/contact/"
  />

  <Footer />
</Base>

<style>
  .dev-note {
    margin-bottom: 1.5rem;
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .work-list li {
    border-top: 1px solid var(--line);
  }

  .work-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 2rem;
    text-decoration: none;
    color: inherit;
    /* transform, not padding: animating layout properties thrashes */
    transition: transform 0.2s var(--ease);
  }

  .row:hover {
    transform: translateX(0.5rem);
  }

  .thumb {
    flex: 0 0 auto;
    width: 280px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--card);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    display: block;
    transition: transform 0.3s var(--ease);
  }

  .row:hover .thumb :global(img) {
    transform: scale(1.03);
  }

  .row-main {
    display: grid;
    gap: 0.5rem;
    flex: 1;
  }

  .row-tag {
    color: var(--copper);
  }

  .row-title {
    font-size: clamp(1.375rem, 2.6vw, 1.875rem);
  }

  .row-go {
    font-size: 1.5rem;
    color: var(--line);
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .row:hover .row-go {
    color: var(--copper);
    transform: translateX(4px);
  }

  .sample {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--mute);
  }

  .empty {
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: clamp(1.75rem, 4vw, 3rem);
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 52rem;
  }

  .empty .btn {
    margin-top: 0.5rem;
  }

  @media (max-width: 820px) {
    .row {
      flex-wrap: wrap;
      gap: 1.25rem;
    }

    .thumb {
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .row-go {
      display: none;
    }
  }
</style>
