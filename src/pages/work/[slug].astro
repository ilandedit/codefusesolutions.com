---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Band from '../../components/Band.astro';
import Figure from '../../components/Figure.astro';
import VideoBlock from '../../components/VideoBlock.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work'))
    .filter((entry) => !(import.meta.env.PROD && entry.data.sample))
    .sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const hasNext = next && next.id !== entry.id;
---

<Base title={`${entry.data.title} — CodeFuse Solutions`} description={entry.data.summary}>
  <Header />

  <main>
    <section class="wrap page-head">
      <p class="label">
        <a class="back" href="/work/">Work</a> /
        {entry.data.client ?? 'Case study'}
        {entry.data.year && ` · ${entry.data.year}`}
        {entry.data.sample && <span class="sample">Sample</span>}
      </p>
      <h1 class="display case-title">{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
    </section>

    {
      entry.data.cover && (
        <section class="wrap lead">
          <Figure
            src={entry.data.cover}
            alt={entry.data.coverAlt ?? `${entry.data.title} — screenshot`}
            eager
            wide
          />
        </section>
      )
    }

    <section class="wrap section">
      <article class="case-body">
        <Content />
      </article>

      {
        entry.data.video && (
          <VideoBlock
            src={entry.data.video.src}
            poster={entry.data.video.poster}
            caption={entry.data.video.caption}
            autoplay={entry.data.video.autoplay}
          />
        )
      }

      {
        entry.data.gallery && entry.data.gallery.length > 0 && (
          <div class="gallery">
            {entry.data.gallery.map((shot) => (
              <Figure src={shot.src} alt={shot.alt} caption={shot.caption} wide />
            ))}
          </div>
        )
      }

      {
        hasNext && (
          <a class="next" href={`/work/${next.id}/`}>
            <span class="label">Next case study</span>
            <span class="next-title title">{next.data.title}</span>
            <span class="next-go" aria-hidden="true">&rarr;</span>
          </a>
        )
      }
    </section>
  </main>

  <Band
    heading="Have a problem like this one?"
    copy="Tell us what you're up against. We'll tell you honestly whether we're the right studio for it."
    cta="Get in touch"
    href="/contact/"
  />

  <Footer />
</Base>

<style>
  .case-title {
    font-size: clamp(1.875rem, 4.2vw, 3.25rem);
    max-width: 20ch;
  }

  .back {
    color: var(--copper);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .back:hover {
    border-bottom-color: var(--copper);
  }

  .sample {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--mute);
  }

  .lead {
    padding-top: 0.5rem;
  }

  .case-body {
    max-width: 68ch;
  }

  /* Screenshots written inline in the markdown body. */
  .case-body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin-block: 2rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--card);
  }

  .gallery {
    display: grid;
  }

  .case-body :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.25;
    color: var(--ink);
    margin: 2.5em 0 0.75em;
  }

  .case-body :global(h2:first-child) {
    margin-top: 0;
  }

  .case-body :global(p) {
    color: var(--mute);
    margin-block: 1em;
    max-width: 62ch;
  }

  .case-body :global(a) {
    color: var(--copper);
  }

  .next {
    margin-top: clamp(3rem, 8vh, 4.5rem);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .next:hover {
    border-color: var(--copper);
    transform: translateY(-2px);
  }

  .next .label {
    grid-column: 1;
  }

  .next-title {
    grid-column: 1;
  }

  .next-go {
    grid-column: 2;
    grid-row: 1 / 3;
    font-size: 1.5rem;
    color: var(--line);
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .next:hover .next-go {
    color: var(--copper);
    transform: translateX(4px);
  }
</style>
