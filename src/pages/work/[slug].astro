---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work'))
    .filter((entry) => !(import.meta.env.PROD && entry.data.sample))
    .sort((a, b) => a.data.order - b.data.order);
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — CodeFuse Solutions`} description={entry.data.summary}>
  <Header showWork={true} />

  <main class="wrap">
    <article>
      <header class="case-head">
        <p class="ptag">
          {entry.data.client ?? 'Case study'}{entry.data.year && ` · ${entry.data.year}`}
          {entry.data.sample && <span class="sample">Sample</span>}
        </p>
        <h1 class="headline">{entry.data.title}</h1>
        <p class="lede">{entry.data.summary}</p>
      </header>
      <div class="case-body">
        <Content />
      </div>
      <aside class="case-close">
        <p class="body-copy">Have a problem like this one?</p>
        <a class="btn" href="/#contact">Tell us about it</a>
      </aside>
    </article>
  </main>

  <Footer />
</Base>

<style>
  .case-head {
    padding-top: clamp(3rem, 10vh, 6rem);
    display: grid;
    gap: 1.25rem;
    max-width: 60ch;
  }

  .ptag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--live);
  }

  .sample {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--mute);
    letter-spacing: 0.04em;
  }

  .case-body {
    padding-block: clamp(2.5rem, 7vh, 4rem);
    max-width: 68ch;
  }

  .case-body :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.25;
    margin: 2.5em 0 0.75em;
  }

  .case-body :global(p) {
    color: var(--mute);
    margin-block: 1em;
  }

  .case-body :global(a) {
    color: var(--volt);
  }

  .case-close {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-block: clamp(2rem, 6vh, 3rem) clamp(4rem, 12vh, 6rem);
  }
</style>
