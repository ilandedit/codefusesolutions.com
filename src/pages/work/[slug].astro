---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Band from '../../components/Band.astro';
import Figure from '../../components/Figure.astro';
import VideoBlock from '../../components/VideoBlock.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort(
    (a, b) => a.data.order - b.data.order
  );
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const hasNext = next && next.id !== entry.id;
---

<Base title={`${entry.data.title} — CodeFuse Solutions`} description={entry.data.summary}>
  <Header />

  <main>
    <section class="wrap page-head">
      <p class="label">
        <a class="back" href="/work/">Work</a> /
        {entry.data.client ?? 'Case study'}
        {entry.data.year && ` · ${entry.data.year}`}
        {entry.data.sample && <span class="sample">Sample</span>}
      </p>
      <h1 class="display case-title">{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
    </section>

    {
      entry.data.cover && (
        <section class="wrap lead">
          <Figure
            src={entry.data.cover}
            alt={entry.data.coverAlt ?? `${entry.data.title} — screenshot`}
            eager
            wide
          />
        </section>
      )
    }

    <section class="column section case">
      <article class="case-body">
        <Content />
      </article>

      {
        entry.data.video && (
          <VideoBlock
            src={entry.data.video.src}
            poster={entry.data.video.poster}
            caption={entry.data.video.caption}
            autoplay={entry.data.video.autoplay}
          />
        )
      }

      {
        entry.data.gallery && entry.data.gallery.length > 0 && (
          <div class="gallery">
            {entry.data.gallery.map((shot) => (
              <Figure src={shot.src} alt={shot.alt} caption={shot.caption} wide />
            ))}
          </div>
        )
      }

      {
        hasNext && (
          <a class="next" href={`/work/${next.id}/`}>
            <span class="label">Next case study</span>
            <span class="next-title title">{next.data.title}</span>
            <span class="next-go" aria-hidden="true">&rarr;</span>
          </a>
        )
      }
    </section>
  </main>

  <Band
    heading="Have a problem like this one?"
    copy="Tell us what you're up against. We'll tell you honestly whether we're the right studio for it."
    cta="Get in touch"
    href="/contact/"
  />

  <Footer />
</Base>

<style>
  .case-title {
    font-size: clamp(2.25rem, 5.4vw, 4.5rem);
    max-width: 18ch;
  }

  .back {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .back:hover {
    border-bottom-color: currentColor;
  }

  .sample {
    display: inline-block;
    margin-left: 0.625rem;
    padding: 0 0.5rem;
    border: 1px solid var(--line);
    color: var(--mute);
  }

  .lead :global(.figure) {
    margin-top: 0;
  }

  .case {
    padding-top: clamp(1rem, 4vh, 2.5rem);
  }

  /* Screenshots written inline in the markdown body. */
  .case-body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin-block: 2rem;
    border: 1px solid var(--line);
    background: #fff;
  }

  .gallery {
    display: grid;
  }

  .case-body :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 3vw, 2.1875rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--heading);
    margin: 2em 0 0.75em;
  }

  .case-body :global(h2:first-child) {
    margin-top: 0;
  }

  .case-body :global(p) {
    margin-block: 1.1em;
  }

  .case-body :global(a) {
    color: var(--copper-deep);
  }

  .next {
    margin-top: clamp(3rem, 8vh, 4.5rem);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding-block: 1.75rem;
    border-block: 2px solid var(--ink);
    text-decoration: none;
    color: inherit;
  }

  .next .label,
  .next-title {
    grid-column: 1;
  }

  .next-title {
    font-size: clamp(1.375rem, 2.6vw, 1.75rem);
    transition: color 0.18s var(--ease);
  }

  .next-go {
    grid-column: 2;
    grid-row: 1 / 3;
    font-size: 1.75rem;
    color: var(--ink);
    transition: transform 0.2s var(--ease);
  }

  .next:hover .next-title {
    color: var(--copper-deep);
  }

  .next:hover .next-go {
    transform: translateX(6px);
  }
</style>
