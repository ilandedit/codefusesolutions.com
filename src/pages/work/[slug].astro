---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort(
    (a, b) => a.data.order - b.data.order
  );
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, catalogNumber: `CF ${String(4 + i).padStart(3, '0')}` },
  }));
}

const { entry, catalogNumber } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — CodeFuse Solutions`} description={entry.data.summary}>
  <Header showWork={true} />

  <main class="wrap">
    <article>
      <header class="case-head">
        <p class="label num">
          {catalogNumber} — case study{entry.data.year && ` · ${entry.data.year}`}
        </p>
        <h1 class="section-title">{entry.data.title}</h1>
        <p class="body-copy">{entry.data.summary}</p>
      </header>
      <div class="case-body">
        <Content />
      </div>
    </article>
  </main>

  <Footer />
</Base>

<style>
  .case-head {
    padding-top: clamp(3.5rem, 12vh, 7rem);
    display: grid;
    gap: 1.5rem;
  }

  .num {
    color: var(--industrial);
  }

  .case-body {
    padding-block: clamp(3rem, 8vh, 5rem) clamp(5rem, 12vh, 8rem);
    max-width: 68ch;
  }

  .case-body :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.2;
    margin: 3em 0 1em;
  }

  .case-body :global(p) {
    color: var(--industrial);
    margin-block: 1em;
  }

  .case-body :global(a) {
    color: var(--pulse);
  }
</style>
