---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Contact — CodeFuse Solutions"
  description="Tell CodeFuse Solutions what you're up against. We'll tell you honestly whether we're the right studio for it."
>
  <Header />

  <main>
    <section class="wrap page-head">
      <p class="label">Contact</p>
      <h1 class="display">Tell us what you&rsquo;re up against.</h1>
      <p class="lede">
        We want to hear about the challenges you&rsquo;re facing! Describe the
        problem or idea in as much detail as you have. Then we&rsquo;ll reach
        out and setup a time to have a conversation on how we can solve your
        problem or build a solution to save you time!
      </p>
    </section>

    <section class="wrap section contact-body">
      <div class="mail-block" data-reveal>
        <p class="label">Email</p>
        <div class="mail-row">
          <a class="mail" href="mailto:codefusesolutions@protonmail.com?subject=Project%20inquiry">
            codefusesolutions@protonmail.com
          </a>
          <div class="mail-actions">
            <button class="btn-ghost" type="button" data-copy="codefusesolutions@protonmail.com">
              Copy address
            </button>
            <span class="small copy-note" data-copy-note aria-live="polite"></span>
          </div>
        </div>
      </div>

      <div class="helper" data-reveal>
        <div class="helper-col">
        <h2 class="title">Who reads this</h2>
        <div class="who">
          <span class="avatar" aria-hidden="true">DW</span>
          <div>
            <p class="title who-name">Derrick Wengerd</p>
            <p class="small who-role">Founder</p>
          </div>
        </div>
        <p class="body-copy who-note">
          You&rsquo;ll get a reply from me, not an autoresponder or a sales
          sequence. There&rsquo;s no cost to the first conversation and
          nothing to sign, and what you describe stays between us.
        </p>
        </div>

        <div class="helper-col">
        <h2 class="title helper-h">Helpful things to mention</h2>
        <ul class="body-copy">
          <li>What the process looks like today, and where it breaks.</li>
          <li>What you&rsquo;ve already tried, including software you&rsquo;ve outgrown.</li>
          <li>Who depends on it working, and what happens when it doesn&rsquo;t.</li>
          <li>Any deadline you&rsquo;re working against.</li>
        </ul>
        <p class="body-copy note">
          None of it is required. A sentence about the problem is enough to
          start a conversation.
        </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const note = document.querySelector<HTMLElement>('[data-copy-note]');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      if (note) note.textContent = 'Copied.';
    } catch {
      if (note) note.textContent = 'Select the address above to copy it.';
    }
    setTimeout(() => {
      if (note) note.textContent = '';
    }, 2500);
  });
</script>

<style>
  .contact-body {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(4rem, 12vh, 7rem);
  }

  .mail-block {
    display: grid;
    gap: 1rem;
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .mail-row {
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
  }

  .mail {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1rem, 2.75vw, 2.25rem);
    line-height: 1.15;
    color: var(--navy);
    text-decoration: none;
    border-bottom: 2px solid var(--copper);
    padding-bottom: 4px;
    white-space: nowrap;
    transition: color 0.18s var(--ease);
  }

  .mail:hover {
    color: var(--copper);
  }

  .mail-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .copy-note {
    color: var(--copper);
  }

  .who {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: 1rem;
  }

  .avatar {
    width: 52px;
    height: 52px;
    flex: 0 0 auto;
    border-radius: 6px;
    display: grid;
    place-items: center;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
  }

  .who-name {
    font-size: 1.0625rem;
  }

  .who-role {
    color: var(--mute);
  }

  .who-note {
    margin-top: 1rem;
  }

  .helper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .helper-col:last-child {
    border-left: 1px solid var(--line);
    padding-left: clamp(1.5rem, 4vw, 3rem);
  }

  .helper ul {
    margin: 1rem 0 0;
    padding-left: 1.125rem;
    display: grid;
    gap: 0.5rem;
  }

  .helper .note {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
  }

  @media (max-width: 820px) {
    .helper {
      grid-template-columns: 1fr;
    }

    .helper-col:last-child {
      border-left: 0;
      padding-left: 0;
      margin-top: 1rem;
      padding-top: 2rem;
      border-top: 1px solid var(--line);
    }
  }
</style>
