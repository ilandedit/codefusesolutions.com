---
/*
DIRECTION CONTRACT
THESIS: The studio as a record catalog — everything CodeFuse makes is a
numbered pressed release. Refuses the glowing dark-dashboard dev-shop default
and the replaced light-editorial canon alike.
OWN-WORLD: Matte Void (#0b0b0a), Pulse ink (#f2efe6), engraved Technor caps
over Martian Mono, hairline rules, coded color strips, Contact Red reserved,
radial Pulse Plot. Recognizable with all content removed.
STORY: A business owner reads an engraved offer beside a pressed signal,
scans numbered entries (work, method, studio), and reaches a red contact
entry with the address in plain text — labeled, never withheld.
FIRST VIEWPORT: 7/5 split — engraved statement + mono lede + bordered CTA
targeting #contact left; the Pulse Plot drawing itself right; email visible.
FORM: Catalog Sleeve (dealt challenger, seed 327a825f) fused per fusion rule;
staging: numbered-entry scroll. Craft bar: the world's QUALITY BAR card.
*/
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);
const hasWork = work.length > 0;

// Deterministic pulse plot: seeded PRNG so every build presses the same record.
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20260724);
const C = 210;
const rays = Array.from({ length: 168 }, (_, i) => {
  const angle = (i / 168) * Math.PI * 2 + (rand() - 0.5) * 0.03;
  const r = rand();
  const inner = 6 + rand() * 10;
  const outer = 28 + Math.pow(r, 2.2) * 168;
  return {
    x1: C + Math.cos(angle) * inner,
    y1: C + Math.sin(angle) * inner,
    x2: C + Math.cos(angle) * outer,
    y2: C + Math.sin(angle) * outer,
    dot: r > 0.72,
  };
});
const ticks = Array.from({ length: 72 }, (_, i) => {
  const angle = (i / 72) * Math.PI * 2;
  const len = i % 6 === 0 ? 10 : 5;
  return {
    x1: C + Math.cos(angle) * 196,
    y1: C + Math.sin(angle) * 196,
    x2: C + Math.cos(angle) * (196 - len),
    y2: C + Math.sin(angle) * (196 - len),
  };
});
---

<Base
  title="CodeFuse Solutions — Custom software for problems that don't fit off the shelf"
  description="CodeFuse Solutions is an independent software studio that takes on complex, niche problems and builds the exact system your business needs."
>
  <Header showWork={hasWork} />

  <main>
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="label kicker">Independent software studio — est. 2026</p>
        <h1 class="display engraved">
          Custom software for problems that <span class="filled">don&rsquo;t fit</span> off the shelf.
        </h1>
        <p class="body-copy lede">
          CodeFuse Solutions takes on the complex, niche problems off-the-shelf
          software can&rsquo;t touch — and builds the exact system your
          business needs.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#contact">Tell us your problem &rarr;</a>
          <a class="text-link label" href="#method">Method +</a>
        </div>
        <a class="text-link label hero-mail" href="mailto:contact@codefusesolutions.com?subject=Project%20inquiry">
          contact@codefusesolutions.com
        </a>
      </div>
      <figure class="plot" aria-hidden="true">
        <svg viewBox="0 0 420 420" role="presentation">
          <circle cx={C} cy={C} r="196" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5"></circle>
          <g stroke="currentColor" stroke-width="0.75">
            {ticks.map((t) => (
              <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2}></line>
            ))}
          </g>
          <g class="rays" stroke="currentColor" stroke-width="0.6">
            {rays.map((r) => (
              <>
                <line x1={r.x1} y1={r.y1} x2={r.x2} y2={r.y2}></line>
                {r.dot && <circle cx={r.x2} cy={r.y2} r="1.1" fill="currentColor" stroke="none"></circle>}
              </>
            ))}
          </g>
        </svg>
        <figcaption class="label plot-caption">CF&nbsp;000 &mdash; pressed signal</figcaption>
      </figure>
    </section>

    {
      hasWork && (
        <section id="work" class="wrap entry">
          <div class="entry-head">
            <span class="label entry-num">CF&nbsp;004</span>
            <span class="code-strip" aria-hidden="true">
              <i style="background: var(--code-blueprint)"></i>
              <i style="background: var(--code-frequency)"></i>
              <i style="background: var(--code-energy)"></i>
            </span>
            <h2 class="section-title">Selected work</h2>
          </div>
          <ul class="work-list">
            {work.map((entry, i) => (
              <li data-scroll-reveal>
                <a class="work-item" href={`/work/${entry.id}/`}>
                  <span class="label entry-num">CF&nbsp;{String(4 + i).padStart(3, '0')}</span>
                  <h3 class="entry-title">{entry.data.title}</h3>
                  <p class="body-copy">{entry.data.summary}</p>
                  <span class="label view">View &rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="wrap entry">
      <div class="entry-head" data-scroll-reveal>
        <span class="label entry-num">CF&nbsp;001</span>
        <span class="code-strip" aria-hidden="true">
          <i style="background: var(--code-blueprint)"></i>
          <i style="background: var(--code-frequency)"></i>
          <i style="background: var(--code-energy)"></i>
        </span>
        <h2 class="section-title">The work we take on</h2>
      </div>
      <div class="row" data-scroll-reveal>
        <div class="row-head">
          <span class="code-strip" aria-hidden="true"><i style="background: var(--code-blueprint)"></i></span>
          <h3 class="entry-title">Systems that don&rsquo;t exist yet</h3>
        </div>
        <p class="body-copy">
          When nothing on the market matches how your business actually runs,
          we design and build the system that does — from the first
          conversation to the day it goes live.
        </p>
      </div>
      <div class="row" data-scroll-reveal>
        <div class="row-head">
          <span class="code-strip" aria-hidden="true"><i style="background: var(--code-frequency)"></i></span>
          <h3 class="entry-title">Software that bends to your business</h3>
        </div>
        <p class="body-copy">
          Integrations, automations, and replacements for tools you&rsquo;ve
          outgrown — built around your operation instead of forcing your
          operation around them.
        </p>
      </div>
      <div class="row" data-scroll-reveal>
        <div class="row-head">
          <span class="code-strip" aria-hidden="true"><i style="background: var(--code-energy)"></i></span>
          <h3 class="entry-title">Problems other shops passed on</h3>
        </div>
        <p class="body-copy">
          The odd, gnarly, deeply specific work. Complexity is the reason to
          call us, not a reason to apologize.
        </p>
      </div>
    </section>

    <section id="method" class="wrap entry">
      <div class="entry-head" data-scroll-reveal>
        <span class="label entry-num">CF&nbsp;002</span>
        <span class="code-strip" aria-hidden="true">
          <i style="background: var(--code-frequency)"></i>
          <i style="background: var(--code-blueprint)"></i>
        </span>
        <h2 class="section-title">Method</h2>
      </div>
      <div class="steps">
        <div class="step" data-scroll-reveal>
          <h3 class="entry-title">Understand first</h3>
          <p class="body-copy">
            We start with how your business actually works — the process, the
            constraints, the edge cases that make your problem yours. Nothing
            gets built until the problem is genuinely understood.
          </p>
        </div>
        <div class="step" data-scroll-reveal>
          <h3 class="entry-title">Build precisely</h3>
          <p class="body-copy">
            Engagements are few and deep, and you talk directly to the person
            building your system. Scope stays honest; decisions get explained
            in plain language.
          </p>
        </div>
        <div class="step" data-scroll-reveal>
          <h3 class="entry-title">Stand behind it</h3>
          <p class="body-copy">
            We ship software we&rsquo;re prepared to live with — and we stay
            reachable after launch, because a custom system is a relationship,
            not a handoff.
          </p>
        </div>
      </div>
    </section>

    <section id="studio" class="wrap entry">
      <div class="entry-head" data-scroll-reveal>
        <span class="label entry-num">CF&nbsp;003</span>
        <span class="code-strip" aria-hidden="true">
          <i style="background: var(--code-energy)"></i>
          <i style="background: var(--code-frequency)"></i>
        </span>
        <h2 class="section-title">The studio</h2>
      </div>
      <p class="studio-copy" data-scroll-reveal>
        CodeFuse Solutions is the independent studio of founder Derrick
        Wengerd. We keep the practice deliberately small so every engagement
        gets senior attention from the first conversation to the shipped
        system — and we only take on work we can do exceptionally well.
      </p>
    </section>

    <section id="contact" class="wrap entry closing">
      <div class="entry-head" data-scroll-reveal>
        <span class="label entry-num contact-num">CF&nbsp;007</span>
        <span class="code-strip" aria-hidden="true"><i style="background: var(--code-contact)"></i></span>
        <h2 class="section-title">Contact</h2>
      </div>
      <p class="body-copy lede" data-scroll-reveal>
        Tell us what you&rsquo;re up against. We&rsquo;ll tell you honestly
        whether we&rsquo;re the right studio for it.
      </p>
      <a
        class="mail-link"
        href="mailto:contact@codefusesolutions.com?subject=Project%20inquiry"
        data-scroll-reveal
      >
        contact@codefusesolutions.com
      </a>
      <div class="contact-actions" data-scroll-reveal>
        <button class="btn btn-contact" type="button" data-copy="contact@codefusesolutions.com">
          Copy address
        </button>
        <span class="label copy-note" data-copy-note aria-live="polite"></span>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  // Copy-address affordance: the fallback for machines with no mail client.
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const note = document.querySelector<HTMLElement>('[data-copy-note]');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      if (note) note.textContent = 'Copied.';
    } catch {
      if (note) note.textContent = 'Select the address above to copy it.';
    }
    setTimeout(() => {
      if (note) note.textContent = '';
    }, 2500);
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-top: clamp(3.5rem, 10vh, 7rem);
    padding-bottom: clamp(3.5rem, 10vh, 7rem);
  }

  .hero-copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }

  .kicker {
    color: var(--industrial);
  }

  .hero .display {
    max-width: 16ch;
  }

  .lede {
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 0.5rem;
  }

  .hero-mail {
    color: var(--industrial);
  }

  .hero-mail:hover {
    color: var(--pulse);
  }

  /* entrance: the sleeve prints once */
  html.js .hero-copy > * {
    opacity: 0;
    transform: translateY(16px);
    animation: press 0.8s var(--ease-out-expo) forwards;
  }

  html.js .hero-copy > *:nth-child(2) { animation-delay: 90ms; }
  html.js .hero-copy > *:nth-child(3) { animation-delay: 180ms; }
  html.js .hero-copy > *:nth-child(4) { animation-delay: 270ms; }
  html.js .hero-copy > *:nth-child(5) { animation-delay: 360ms; }

  @keyframes press {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .plot {
    margin: 0;
    display: grid;
    gap: 1rem;
    justify-items: center;
    color: var(--pulse);
  }

  .plot svg {
    width: min(100%, 420px);
    height: auto;
  }

  .plot-caption {
    color: var(--industrial);
  }

  html.js .plot .rays {
    opacity: 0;
    animation: press-plot 1.4s linear 0.3s forwards;
  }

  @keyframes press-plot {
    to {
      opacity: 1;
    }
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 1rem 4rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--hairline);
  }

  .row-head {
    display: grid;
    gap: 0.875rem;
    justify-items: start;
    align-content: start;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem;
  }

  .step h3 {
    margin-bottom: 1rem;
  }

  .studio-copy {
    font-size: 1.0625rem;
    line-height: 1.8;
    max-width: 58ch;
    color: var(--pulse);
  }

  .closing {
    display: grid;
    gap: 2rem;
    justify-items: start;
    padding-bottom: clamp(5rem, 14vh, 9rem);
  }

  .contact-num {
    color: var(--code-contact);
  }

  .mail-link {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.25rem, 3.2vw, 2.625rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--pulse);
    text-decoration: none;
    background-image: linear-gradient(var(--code-contact), var(--code-contact));
    background-repeat: no-repeat;
    background-size: 100% 3px;
    background-position: 0 100%;
    padding-bottom: 8px;
    overflow-wrap: anywhere;
    transition: color 120ms linear;
  }

  .mail-link:hover {
    color: var(--code-contact);
  }

  .contact-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .copy-note {
    color: var(--industrial);
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work-item {
    display: grid;
    gap: 0.75rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--hairline);
    text-decoration: none;
    color: var(--pulse);
    justify-items: start;
  }

  .work-item .view {
    color: var(--industrial);
    transition: color 120ms linear;
  }

  .work-item:hover .view {
    color: var(--pulse);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .plot svg {
      width: min(70vw, 320px);
    }
  }

  @media (max-width: 820px) {
    .row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .steps {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
