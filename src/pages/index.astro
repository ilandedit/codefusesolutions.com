---
/*
DIRECTION CONTRACT
THESIS: A four-page studio site with engineering-firm credibility and a warm
metal edge. Refuses the one-page scroll, the dark-plus-neon machine look, and
the grey-and-blue template.
OWN-WORLD: White ground, navy structure and actions, copper for the human
half; Clash Display over Switzer; full-bleed navy bands closing each page.
STORY: A business owner reads the claim, sees what we take on and a taste of
the work, and follows the band deeper into the site — or straight to contact.
FIRST VIEWPORT: Copper eyebrow, display claim, lede, navy action, plain email.
FORM: Palette chosen from a six-way board (colour isolated as the only
variable); multi-page structure chosen by the user over the single scroll.
*/
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Band from '../components/Band.astro';
import { Image } from 'astro:assets';

const work = (await getCollection('work'))
  .filter((entry) => !(import.meta.env.PROD && entry.data.sample))
  .sort((a, b) => a.data.order - b.data.order);
const featured = work.slice(0, 2);
---

<Base
  title="CodeFuse Solutions — Custom software for problems that don't fit off the shelf"
  description="An independent software studio that takes on complex, niche problems and builds the exact system your business needs."
>
  <Header />

  <main>
    <section class="wrap page-head hero">
      <p class="label">Independent software studio</p>
      <h1 class="display">
        Custom software for problems that don&rsquo;t fit off the shelf.
      </h1>
      <p class="lede">
        CodeFuse Solutions takes on the complex, niche problems off-the-shelf
        software can&rsquo;t touch — and builds the exact system your business
        needs.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/contact/">Tell us your problem</a>
        <a class="text-link small" href="/studio/">How we work</a>
      </div>
      <p class="hero-mail small">
        Or email directly:
        <a href="mailto:codefusesolutions@protonmail.com?subject=Project%20inquiry">
          codefusesolutions@protonmail.com
        </a>
      </p>
    </section>

    <section class="wrap section">
      <div class="section-head" data-reveal>
        <h2 class="headline">The work we take on</h2>
      </div>
      <div class="takes">
        <div class="take" data-reveal>
          <h3 class="title">Systems that don&rsquo;t exist yet</h3>
          <p class="body-copy">
            When nothing on the market matches how your business actually runs,
            we design and build the system that does.
          </p>
        </div>
        <div class="take" data-reveal>
          <h3 class="title">Software that bends to your business</h3>
          <p class="body-copy">
            Integrations, automations, and replacements for tools you&rsquo;ve
            outgrown — built around your operation, not the reverse.
          </p>
        </div>
        <div class="take" data-reveal>
          <h3 class="title">Problems other shops passed on</h3>
          <p class="body-copy">
            The odd, gnarly, deeply specific work. Complexity is the reason to
            call us, not a reason to apologize.
          </p>
        </div>
      </div>
    </section>

    <section class="wrap section">
      <div class="section-head" data-reveal>
        <h2 class="headline">Where we are right now</h2>
      </div>
      <div class="now">
        <div class="now-main" data-reveal>
          <p class="lede now-lede">
            CodeFuse is a young studio, and we&rsquo;d rather tell you that
            plainly than pad this page with stock photography and invented
            metrics.
          </p>
          <p class="body-copy">
            Our first commercial product is in build now. We won&rsquo;t show
            you a screenshot of it until it&rsquo;s real — but we&rsquo;ll
            happily walk you through what it does, how it&rsquo;s put together,
            and the decisions behind it, on a call.
          </p>
          <p class="body-copy">
            The same goes for your problem: you&rsquo;ll get a direct answer
            from the person who would actually build it, not a proposal
            assembled by someone who won&rsquo;t.
          </p>
        </div>
        <aside class="now-side" data-reveal>
          <p class="label">Who you&rsquo;ll be talking to</p>
          <div class="who">
            <span class="avatar" aria-hidden="true">DW</span>
            <div>
              <p class="title">Derrick Wengerd</p>
              <p class="small who-role">Founder · reads every message himself</p>
            </div>
          </div>
          <a class="text-link small" href="/studio/">How we work &rarr;</a>
        </aside>
      </div>
    </section>

    {
      featured.length > 0 && (
        <section class="wrap section">
          <div class="section-head" data-reveal>
            <h2 class="headline">Selected work</h2>
            <a class="text-link small" href="/work/">
              All work &rarr;
            </a>
          </div>
          <div class="work">
            {featured.map((entry) => (
              <a class="proj" href={`/work/${entry.id}/`} data-reveal>
                {entry.data.cover && (
                  <span class="proj-thumb">
                    <Image
                      src={entry.data.cover}
                      alt=""
                      widths={[480, 960]}
                      sizes="(max-width: 900px) 100vw, 440px"
                      format="webp"
                      quality={72}
                      loading="lazy"
                    />
                  </span>
                )}
                <p class="label proj-tag">
                  {entry.data.client ?? 'Case study'}
                  {entry.data.year && ` · ${entry.data.year}`}
                  {entry.data.sample && <span class="sample">Sample</span>}
                </p>
                <h3 class="title">{entry.data.title}</h3>
                <p class="body-copy">{entry.data.summary}</p>
                <span class="small view">Read the case study &rarr;</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <Band
    heading="Have a problem that doesn't fit?"
    copy="Tell us what you're up against. We'll tell you honestly whether we're the right studio for it."
    cta="Get in touch"
    href="/contact/"
  />

  <Footer />
</Base>

<style>
  .hero {
    padding-bottom: clamp(3rem, 8vh, 4.5rem);
  }

  .hero .display {
    max-width: 17ch;
  }

  .hero-actions {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-mail {
    color: var(--mute);
  }

  .hero-mail a {
    color: var(--mute);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: color 0.18s var(--ease);
  }

  .hero-mail a:hover {
    color: var(--copper);
  }

  .takes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  /* "Where we are right now" — the honest substitute for proof we don't have */
  .now {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .now-main {
    display: grid;
    gap: 1rem;
  }

  .now-lede {
    color: var(--ink);
    max-width: 46ch;
  }

  .now-side {
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.5rem;
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .avatar {
    width: 52px;
    height: 52px;
    flex: 0 0 auto;
    border-radius: 6px;
    display: grid;
    place-items: center;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
  }

  .who-role {
    color: var(--mute);
  }

  .take {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.5rem;
    display: grid;
    gap: 0.625rem;
    align-content: start;
  }

  .work {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }

  .proj {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.5rem;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .proj-thumb {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--paper);
    margin-bottom: 0.75rem;
  }

  .proj-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    display: block;
    transition: transform 0.3s var(--ease);
  }

  .proj:hover .proj-thumb :global(img) {
    transform: scale(1.03);
  }

  .proj:hover {
    border-color: var(--copper);
    transform: translateY(-2px);
  }

  .proj-tag {
    color: var(--copper);
  }

  .sample {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--mute);
    background: var(--paper);
  }

  .view {
    margin-top: 0.25rem;
    color: var(--mute);
    transition: color 0.18s var(--ease);
  }

  .proj:hover .view {
    color: var(--copper);
  }

  @media (max-width: 900px) {
    .takes {
      grid-template-columns: 1fr;
    }

    .now {
      grid-template-columns: 1fr;
    }
  }
</style>
