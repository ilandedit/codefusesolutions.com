---
/*
DIRECTION CONTRACT
THESIS: A dark, precise studio surface where two accent colors carry the two
halves of the work — green listens, blue builds. Refuses decorative color,
the characterless light canon, and every borrowed conceptual costume.
OWN-WORLD: Near-black ground (#0c0e12), quiet panels on hairlines, Clash
Display over Switzer, Live green + Volt blue with assigned meaning, flat
depth, one gradient (the method bar) in the entire system.
STORY: A business owner reads what we do, sees what we take on, finds proof,
learns how we work in three steps, meets the founder, and emails.
FIRST VIEWPORT: Eyebrow, two-color statement, lede, blue CTA to #contact,
ghost link to method, and the address in plain text.
IA (approved, binding): claim → what → proof → how → who → ask. No section
restates another; the page ends on the ask.
FORM: "Signal" — user-selected from three working comps, then restructured
after the first arrangement read as repetitive. Craft bar: adhamdannaway.com,
tamalsen.dev.
*/
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Sample entries preview the layout in dev; production ships real work only.
const work = (await getCollection('work'))
  .filter((entry) => !(import.meta.env.PROD && entry.data.sample))
  .sort((a, b) => a.data.order - b.data.order);
const hasWork = work.length > 0;
---

<Base
  title="CodeFuse Solutions — Custom software for problems that don't fit off the shelf"
  description="CodeFuse Solutions is an independent software studio that takes on complex, niche problems and builds the exact system your business needs."
>
  <Header showWork={hasWork} />

  <main>
    <!-- 1 · CLAIM -->
    <section class="hero wrap">
      <p class="label eyebrow">Independent software studio</p>
      <h1 class="display">
        We <span class="listen">listen</span> like consultants and
        <span class="build">build</span> like engineers.
      </h1>
      <p class="lede">
        CodeFuse Solutions takes on the complex, niche problems off-the-shelf
        software can&rsquo;t touch — and builds the exact system your business
        needs.
      </p>
      <div class="hero-actions">
        <a class="btn" href="#contact">Tell us your problem</a>
        <a class="text-link small" href="#method">See how we work</a>
      </div>
      <p class="hero-mail small">
        Or email us directly:
        <a href="mailto:contact@codefusesolutions.com?subject=Project%20inquiry">
          contact@codefusesolutions.com
        </a>
      </p>
    </section>

    <!-- 2 · WHAT (capabilities live here and nowhere else) -->
    <section class="wrap section">
      <div class="section-head" data-reveal>
        <h2 class="headline">The work we take on</h2>
      </div>
      <div class="takes">
        <div class="take" data-reveal>
          <span class="ic" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 13V5a1 1 0 011-1h4l2 2h6a1 1 0 011 1v6a1 1 0 01-1 1H3a1 1 0 01-1-1z"></path>
            </svg>
          </span>
          <h3 class="title">Systems that don&rsquo;t exist yet</h3>
          <p class="body-copy">
            When nothing on the market matches how your business actually runs,
            we design and build the system that does.
          </p>
        </div>
        <div class="take" data-reveal>
          <span class="ic" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3L3 9l3 6M12 3l3 6-3 6"></path>
            </svg>
          </span>
          <h3 class="title">Software that bends to your business</h3>
          <p class="body-copy">
            Integrations, automations, and replacements for tools you&rsquo;ve
            outgrown — built around your operation, not the reverse.
          </p>
        </div>
        <div class="take" data-reveal>
          <span class="ic" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 2l2 4 4 .5-3 3 .8 4.5L9 12l-3.8 2 .8-4.5-3-3L7 6z"></path>
            </svg>
          </span>
          <h3 class="title">Problems other shops passed on</h3>
          <p class="body-copy">
            The odd, gnarly, deeply specific work. Complexity is the reason to
            call us, not a reason to apologize.
          </p>
        </div>
      </div>
    </section>

    <!-- 3 · PROOF (renders only when a case study exists) -->
    {
      hasWork && (
        <section id="work" class="wrap section">
          <div class="section-head" data-reveal>
            <h2 class="headline">Selected work</h2>
            {
              work.some((e) => e.data.sample) && (
                <p class="section-note">
                  Sample entries — visible in development only, never in the built site
                </p>
              )
            }
          </div>
          <div class="work">
            {work.map((entry) => (
              <a class="proj" href={`/work/${entry.id}/`} data-reveal>
                <div class="pb">
                  <p class="ptag">
                    {entry.data.client ?? 'Case study'}
                    {entry.data.year && ` · ${entry.data.year}`}
                    {entry.data.sample && <span class="sample">Sample</span>}
                  </p>
                  <h3 class="title">{entry.data.title}</h3>
                  <p class="body-copy">{entry.data.summary}</p>
                  <span class="small view">Read the case study &rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- 4 · HOW (one object, three parts — the sequence is the point) -->
    <section id="method" class="wrap section">
      <div class="section-head" data-reveal>
        <h2 class="headline">How we work</h2>
      </div>
      <div class="steps" data-reveal>
        <div class="step s1">
          <p class="stepn">01 — Understand</p>
          <h3 class="title">The conversation comes first</h3>
          <p class="body-copy">
            We start with how your business actually works: the process, the
            constraints, the edge cases that make your problem yours. Nothing
            gets built until it&rsquo;s genuinely understood.
          </p>
        </div>
        <div class="step s2">
          <p class="stepn">02 — Build</p>
          <h3 class="title">Built precisely, explained plainly</h3>
          <p class="body-copy">
            You talk directly to the person building your system. Scope stays
            honest, and decisions get explained in language you can act on.
          </p>
        </div>
        <div class="step s3">
          <p class="stepn">03 — Stand behind it</p>
          <h3 class="title">We stay reachable after launch</h3>
          <p class="body-copy">
            We ship software we&rsquo;re prepared to live with, because a custom
            system is a relationship, not a handoff.
          </p>
        </div>
      </div>
    </section>

    <!-- 5 · WHO -->
    <section id="studio" class="wrap section">
      <div class="section-head" data-reveal>
        <h2 class="headline">The studio</h2>
      </div>
      <div class="studio" data-reveal>
        <span class="avatar" aria-hidden="true">DW</span>
        <div>
          <p class="lede studio-copy">
            CodeFuse Solutions is the independent studio of founder Derrick
            Wengerd. We keep the practice deliberately small so every engagement
            gets senior attention from the first conversation to the shipped
            system — and we only take on work we can do exceptionally well.
          </p>
          <p class="small sig">Derrick Wengerd · Founder</p>
        </div>
      </div>
    </section>

    <!-- 6 · ASK -->
    <section id="contact" class="wrap close">
      <h2 class="close-headline" data-reveal>Have a problem that doesn&rsquo;t fit?</h2>
      <p class="lede" data-reveal>
        Tell us what you&rsquo;re up against. We&rsquo;ll tell you honestly
        whether we&rsquo;re the right studio for it.
      </p>
      <div class="mailrow" data-reveal>
        <a class="mailbig" href="mailto:contact@codefusesolutions.com?subject=Project%20inquiry">
          contact@codefusesolutions.com
        </a>
        <button class="btn-ghost" type="button" data-copy="contact@codefusesolutions.com">
          Copy address
        </button>
        <span class="small copy-note" data-copy-note aria-live="polite"></span>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const note = document.querySelector<HTMLElement>('[data-copy-note]');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      if (note) note.textContent = 'Copied.';
    } catch {
      if (note) note.textContent = 'Select the address above to copy it.';
    }
    setTimeout(() => {
      if (note) note.textContent = '';
    }, 2500);
  });
</script>

<style>
  /* 1 · hero */
  .hero {
    padding-top: clamp(3.5rem, 11vh, 6.5rem);
    padding-bottom: clamp(3rem, 8vh, 5rem);
    display: grid;
    justify-items: start;
    gap: 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--mute);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--live);
  }

  .hero .display {
    max-width: 19ch;
  }

  .listen {
    color: var(--live);
  }

  .build {
    color: var(--volt);
  }

  .hero .lede {
    margin-top: 1.75rem;
  }

  .hero-actions {
    margin-top: 2.25rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-mail {
    margin-top: 1.75rem;
    color: var(--mute);
  }

  .hero-mail a {
    color: var(--mute);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: color 0.18s var(--ease);
  }

  .hero-mail a:hover {
    color: var(--ink);
  }

  /* 2 · capabilities */
  .takes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .take {
    background: var(--panel-quiet);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.5rem 1.5rem 1.625rem;
    display: grid;
    gap: 0.625rem;
    align-content: start;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .take:hover {
    border-color: var(--live);
    transform: translateY(-2px);
  }

  .ic {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--live) 10%, transparent);
    color: var(--live);
    margin-bottom: 0.25rem;
  }

  /* 3 · work */
  .work {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
  }

  .sample {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--mute);
    letter-spacing: 0.04em;
  }

  .proj {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .proj:hover {
    border-color: var(--volt);
    transform: translateY(-3px);
  }

  .pb {
    padding: 1.5rem;
    display: grid;
    gap: 0.5rem;
  }

  .ptag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--live);
  }

  .view {
    color: var(--mute);
    margin-top: 0.25rem;
    transition: color 0.18s var(--ease);
  }

  .proj:hover .view {
    color: var(--volt);
  }

  /* 4 · method — one object, three parts */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }

  .step {
    background: var(--panel-quiet);
    border-right: 1px solid var(--line);
    padding: 1.75rem 1.625rem;
    position: relative;
  }

  .step:last-child {
    border-right: 0;
  }

  .step::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
  }

  /* the one gradient in the system: listening becoming building */
  .s1::before {
    background: var(--live);
  }

  .s2::before {
    background: linear-gradient(90deg, var(--live), var(--volt));
  }

  .s3::before {
    background: var(--volt);
  }

  .stepn {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
    margin-bottom: 0.875rem;
  }

  .step .title {
    margin-bottom: 0.5rem;
  }

  /* 5 · studio */
  .studio {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.75rem);
    align-items: start;
  }

  .avatar {
    width: 84px;
    height: 84px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: linear-gradient(
      140deg,
      color-mix(in srgb, var(--live) 22%, transparent),
      color-mix(in srgb, var(--volt) 22%, transparent)
    );
    border: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.75rem;
  }

  .studio-copy {
    max-width: 56ch;
  }

  .sig {
    margin-top: 1.125rem;
    color: var(--mute);
  }

  /* 6 · close */
  .close {
    border-top: 1px solid var(--line);
    padding-top: clamp(3.5rem, 10vh, 5.5rem);
    padding-bottom: clamp(4rem, 12vh, 6.5rem);
    display: grid;
    justify-items: start;
  }

  .close .close-headline {
    max-width: 16ch;
  }

  .close .lede {
    margin-top: 1.25rem;
    max-width: 50ch;
  }

  .mailrow {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .mailbig {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.25rem, 3vw, 2.125rem);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--volt);
    padding-bottom: 4px;
    overflow-wrap: anywhere;
    transition: color 0.18s var(--ease);
  }

  .mailbig:hover {
    color: var(--volt);
  }

  .copy-note {
    color: var(--live);
  }

  @media (max-width: 900px) {
    .takes,
    .steps {
      grid-template-columns: 1fr;
    }

    .step {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .step:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 820px) {
    .work {
      grid-template-columns: 1fr;
    }

    .studio {
      grid-template-columns: 1fr;
    }
  }
</style>
