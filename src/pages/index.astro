---
/*
DIRECTION CONTRACT
THESIS: A four-page studio site built from inset colour panels: a quiet
off-white page, a centred tracked wordmark, and large fields of navy carrying
big geometric white type.
OWN-WORLD: Off-white ground, navy and copper panels held off the viewport
edge, Jost capitals and headlines over Switzer reading text, square corners,
outline buttons.
STORY: A business owner meets the claim at full size, reads plainly where the
studio is, sees what it takes on and a taste of the work, and is asked.
FIRST VIEWPORT: Split nav around the wordmark; the navy hero panel with the
claim, a tracked-caps line and one outline action.
*/
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Band from '../components/Band.astro';
import Panel from '../components/Panel.astro';
import WorkTile from '../components/WorkTile.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/studio/derrick-wengerd.jpg';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = work.slice(0, 2);
---

<Base
  title="CodeFuse Solutions — Custom software for problems that don't fit off the shelf"
  description="An independent software studio that takes on complex, niche problems and builds the exact system your business needs."
>
  <Header />

  <main>
    <!-- To put a photograph behind the hero, import it from src/assets and
         pass it as <Panel image={...}>. -->
    <Panel center tall eager>
      <h1 class="display">
        Custom software for problems that don&rsquo;t fit off the shelf.
      </h1>
      <p class="label">Independent software studio</p>
      <a class="btn btn-invert" href="/contact/">Tell us your problem</a>
    </Panel>

    <section class="column section prose">
      <h2 class="headline" data-reveal>What we do</h2>
      <p data-reveal>
        CodeFuse Solutions takes on the complex, niche problems off-the-shelf
        software can&rsquo;t touch, and builds the exact system your business
        needs.
      </p>

      <h2 class="headline" data-reveal>Where we are right now</h2>
      <p data-reveal>
        CodeFuse is a young studio, and we&rsquo;d rather tell you that plainly
        than pad this page with stock photography and invented metrics.
      </p>
      <p data-reveal>
        Our first commercial product is in build now. We won&rsquo;t show you a
        screenshot of it until it&rsquo;s real — but we&rsquo;ll happily walk
        you through what it does, how it&rsquo;s put together, and the
        decisions behind it, on a call.
      </p>
      <p data-reveal>
        The same goes for your problem: you&rsquo;ll get a direct answer from
        the person who would actually build it, not a proposal assembled by
        someone who won&rsquo;t.
      </p>

      <div class="who" data-reveal>
        <Image
          class="avatar"
          src={portrait}
          alt="Derrick Wengerd, founder of CodeFuse Solutions"
          width={128}
          height={128}
          densities={[1, 2]}
        />
        <div>
          <p class="label">Who you&rsquo;ll be talking to</p>
          <p class="title">Derrick Wengerd</p>
          <p class="small who-role">Founder · reads every message himself</p>
        </div>
      </div>
    </section>

    <Panel tone="copper">
      <div class="takes-wrap">
        <h2 class="headline" data-reveal>The work we take on</h2>
        <div class="takes">
          <div class="take" data-reveal>
            <h3 class="title">Systems that don&rsquo;t exist yet</h3>
            <p>
              When nothing on the market matches how your business actually
              runs, we design and build the system that does.
            </p>
          </div>
          <div class="take" data-reveal>
            <h3 class="title">Software that bends to your business</h3>
            <p>
              Integrations, automations, and replacements for tools you&rsquo;ve
              outgrown — built around your operation, not the reverse.
            </p>
          </div>
          <div class="take" data-reveal>
            <h3 class="title">Problems other shops passed on</h3>
            <p>
              The odd, gnarly, deeply specific work. Complexity is the reason
              to call us, not a reason to apologize.
            </p>
          </div>
        </div>
        <a class="btn btn-invert takes-btn" href="/studio/" data-reveal>
          How we work
        </a>
      </div>
    </Panel>

    {
      featured.length > 0 && (
        <section class="wrap section">
          <div class="section-head" data-reveal>
            <h2 class="headline">Selected work</h2>
            <a class="text-link small" href="/work/">
              All work &rarr;
            </a>
          </div>
          <div class="work">
            {featured.map((entry) => (
              <WorkTile entry={entry} />
            ))}
          </div>
        </section>
      )
    }
  </main>

  <Band
    heading="Have a problem that doesn't fit?"
    copy="Tell us what you're up against. We'll tell you honestly whether we're the right studio for it."
    cta="Get in touch"
    href="/contact/"
  />

  <Footer />
</Base>

<style>
  .who {
    margin-top: 1.75rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .avatar {
    width: 64px;
    height: 64px;
    flex: 0 0 auto;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .who-role {
    color: var(--mute);
  }

  .takes-wrap {
    max-width: var(--max);
    margin-inline: auto;
    display: grid;
    justify-items: start;
    gap: 2.5rem;
  }

  .takes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .take {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 2px solid rgba(255, 255, 255, 0.55);
  }

  .take p {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  @media (max-width: 820px) {
    .takes,
    .work {
      grid-template-columns: 1fr;
    }
  }
</style>
