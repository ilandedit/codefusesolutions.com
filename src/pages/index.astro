---
/*
DIRECTION CONTRACT
THESIS: A clean professional page on a visibly drawn grid where exactly one
element per screen doesn't fit — and the misfit is always the action. The
site performs "problems that don't fit off the shelf" on itself. Refuses the
characterless canon and every borrowed conceptual costume.
OWN-WORLD: Warm paper (#fbfaf7), ink, faint drawn column rules; Clash
Display over Switzer; Cobalt (#2b46e0) reserved for misfit actions; tilted
plates with hard offset shadows; quiet ink positional breaks elsewhere.
STORY: A business owner reads an orderly page, keeps catching the one thing
out of line, learns it's always the way to act, and emails.
FIRST VIEWPORT: Aligned kicker, display statement, lede; the tilted Cobalt
CTA plate crossing a column rule (targets #contact); email in plain text.
SIGNATURE: hovering a misfit straightens it — we make it fit.
FORM: Assigned split-seam candidate fused with the dealt grid-break staging
(seed 76a9766b). Craft bar: adhamdannaway.com / tamalsen.dev.
*/
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);
const hasWork = work.length > 0;
---

<Base
  title="CodeFuse Solutions — Custom software for problems that don't fit off the shelf"
  description="CodeFuse Solutions is an independent software studio that takes on complex, niche problems and builds the exact system your business needs."
>
  <Header showWork={hasWork} />

  <main class="grid-stage">
    <section class="hero wrap">
      <p class="label kicker">Independent software studio</p>
      <h1 class="display">
        Custom software for problems that don&rsquo;t fit off the shelf.
      </h1>
      <p class="lede">
        CodeFuse Solutions takes on the complex, niche problems off-the-shelf
        software can&rsquo;t touch — and builds the exact system your business
        needs.
      </p>
      <div class="hero-actions">
        <a class="misfit hero-misfit" href="#contact">Tell us your problem &rarr;</a>
        <a class="text-link label" href="#method">How we work</a>
      </div>
      <a
        class="text-link label hero-mail"
        href="mailto:contact@codefusesolutions.com?subject=Project%20inquiry"
      >
        contact@codefusesolutions.com
      </a>
    </section>

    <section class="wrap section">
      <h2 class="headline section-lead" data-scroll-reveal>The work we take on</h2>
      <div class="row" data-scroll-reveal>
        <h3 class="title">Systems that don&rsquo;t exist yet</h3>
        <p class="body-copy">
          When nothing on the market matches how your business actually runs,
          we design and build the system that does — from the first
          conversation to the day it goes live.
        </p>
      </div>
      <div class="row" data-scroll-reveal>
        <h3 class="title">Software that bends to your business</h3>
        <p class="body-copy">
          Integrations, automations, and replacements for tools you&rsquo;ve
          outgrown — built around your operation instead of forcing your
          operation around them.
        </p>
      </div>
      <div class="row row-break" data-scroll-reveal>
        <h3 class="title">Problems other shops passed on</h3>
        <p class="body-copy">
          The odd, gnarly, deeply specific work. Complexity is the reason to
          call us, not a reason to apologize.
        </p>
      </div>
    </section>

    <section id="method" class="wrap section">
      <h2 class="headline section-lead" data-scroll-reveal>How we work</h2>
      <div class="steps">
        <div class="step" data-scroll-reveal>
          <h3 class="title">Understand first</h3>
          <p class="body-copy">
            We start with how your business actually works — the process, the
            constraints, the edge cases that make your problem yours. Nothing
            gets built until the problem is genuinely understood.
          </p>
        </div>
        <div class="step" data-scroll-reveal>
          <h3 class="title">Build precisely</h3>
          <p class="body-copy">
            Engagements are few and deep, and you talk directly to the person
            building your system. Scope stays honest; decisions get explained
            in plain language.
          </p>
        </div>
        <div class="step step-break" data-scroll-reveal>
          <h3 class="title">Stand behind it</h3>
          <p class="body-copy">
            We ship software we&rsquo;re prepared to live with — and we stay
            reachable after launch, because a custom system is a relationship,
            not a handoff.
          </p>
        </div>
      </div>
    </section>

    <section id="studio" class="wrap section">
      <h2 class="headline section-lead" data-scroll-reveal>The studio</h2>
      <p class="studio-copy" data-scroll-reveal>
        CodeFuse Solutions is the independent studio of founder Derrick
        Wengerd. We keep the practice deliberately small so every engagement
        gets senior attention from the first conversation to the shipped
        system — and we only take on work we can do exceptionally well.
      </p>
    </section>

    {
      hasWork && (
        <section id="work" class="wrap section">
          <h2 class="headline section-lead">Selected work</h2>
          <ul class="work-list">
            {work.map((entry) => (
              <li data-scroll-reveal>
                <a class="work-item" href={`/work/${entry.id}/`}>
                  <h3 class="title">{entry.data.title}</h3>
                  <p class="body-copy">{entry.data.summary}</p>
                  <span class="label view">View &rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="contact" class="wrap section closing">
      <h2 class="display" data-scroll-reveal>Have a problem that doesn&rsquo;t fit?</h2>
      <p class="lede" data-scroll-reveal>
        Tell us what you&rsquo;re up against. We&rsquo;ll tell you honestly
        whether we&rsquo;re the right studio for it.
      </p>
      <a
        class="misfit mail-plate"
        href="mailto:contact@codefusesolutions.com?subject=Project%20inquiry"
        data-scroll-reveal
      >
        contact@codefusesolutions.com
      </a>
      <div class="contact-actions" data-scroll-reveal>
        <button class="text-link label copy-btn" type="button" data-copy="contact@codefusesolutions.com">
          Copy address
        </button>
        <span class="label copy-note" data-copy-note aria-live="polite"></span>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  // Copy-address affordance: the fallback for machines with no mail client.
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const note = document.querySelector<HTMLElement>('[data-copy-note]');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      if (note) note.textContent = 'Copied.';
    } catch {
      if (note) note.textContent = 'Select the address above to copy it.';
    }
    setTimeout(() => {
      if (note) note.textContent = '';
    }, 2500);
  });
</script>

<style>
  .hero {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    padding-top: clamp(4rem, 13vh, 8.5rem);
    padding-bottom: clamp(4rem, 12vh, 8rem);
  }

  .kicker {
    color: var(--slate);
  }

  .hero .display {
    max-width: 15ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2.5rem;
    margin-top: 0.75rem;
  }

  .hero-mail {
    color: var(--slate);
  }

  .hero-mail:hover {
    color: var(--cobalt);
  }

  /* Entrance: order assembles, then the misfit lands. */
  html.js .hero > :not(.hero-actions) {
    opacity: 0;
    transform: translateY(16px);
    animation: assemble 0.7s var(--ease-out-expo) forwards;
  }

  html.js .hero > .display { animation-delay: 80ms; }
  html.js .hero > .lede { animation-delay: 160ms; }
  html.js .hero > .hero-mail { animation-delay: 240ms; }

  html.js .hero-actions {
    opacity: 0;
    animation: assemble 0.5s var(--ease-out-expo) 320ms forwards;
  }

  html.js .hero-misfit {
    rotate: 0deg;
    animation: land 0.55s var(--ease-out-expo) 620ms forwards;
  }

  html.js .hero-misfit:hover,
  html.js .hero-misfit:focus-visible {
    animation-play-state: paused;
    rotate: 0deg;
  }

  @keyframes assemble {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes land {
    from {
      rotate: 0deg;
      transform: translateY(-6px);
    }
    to {
      rotate: -2deg;
      transform: none;
    }
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1rem 3.5rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--gridline);
  }

  /* Quiet break: the misfit problems' own title crosses onto the copy column. */
  .row-break .title {
    position: relative;
    left: clamp(1.5rem, 6vw, 5.5rem);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem;
    align-items: start;
  }

  .step h3 {
    margin-bottom: 0.875rem;
  }

  /* Quiet break: the step that outlasts the others sits below the baseline. */
  .step-break {
    margin-top: 1.5rem;
  }

  /* Quiet break: the studio statement bleeds left across the first rule. */
  .studio-copy {
    font-size: clamp(1.1875rem, 1.9vw, 1.5rem);
    line-height: 1.55;
    max-width: 34em;
    margin-left: calc(-1 * clamp(0.5rem, 2vw, 2rem));
    text-wrap: pretty;
  }

  .closing {
    display: grid;
    gap: 2rem;
    justify-items: start;
    padding-bottom: clamp(5rem, 14vh, 9rem);
  }

  .closing .display {
    max-width: 14ch;
  }

  .mail-plate {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.375rem, 3.2vw, 2.625rem);
    letter-spacing: -0.005em;
    line-height: 1.1;
    padding: 1.5rem 2.25rem;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  .contact-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .copy-btn {
    background: none;
    border: 0;
    padding: 0;
    padding-bottom: 2px;
    cursor: pointer;
    color: var(--ink);
    min-height: 44px;
  }

  .copy-note {
    color: var(--slate);
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work-item {
    display: grid;
    gap: 0.75rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--gridline);
    text-decoration: none;
    color: var(--ink);
    justify-items: start;
  }

  .work-item .view {
    color: var(--slate);
    transition: color 160ms ease-out;
  }

  .work-item:hover .view {
    color: var(--cobalt);
  }

  @media (max-width: 820px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }

    .row-break .title {
      left: clamp(1rem, 8vw, 2.5rem);
    }

    .steps {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .step-break {
      margin-top: 0;
      margin-left: clamp(1rem, 8vw, 2.5rem);
    }

    .mail-plate {
      padding: 1.125rem 1.375rem;
    }
  }
</style>
