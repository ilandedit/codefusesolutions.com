---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Page not found — CodeFuse Solutions"
  description="That page doesn't exist. CodeFuse Solutions builds custom software for complex, niche problems."
>
  <Header />

  <main class="wrap page-head not-found">
    <p class="label">Error 404</p>
    <h1 class="display">This page doesn&rsquo;t exist.</h1>
    <p class="lede">
      The page you were after isn&rsquo;t here — but if your problem is the kind
      nothing off the shelf can solve, you&rsquo;re in the right place.
    </p>
    <div class="actions">
      <a class="btn" href="/">Back to home</a>
      <a class="text-link small" href="/work/">See the work</a>
      <a class="text-link small" href="/contact/">Get in touch</a>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .not-found {
    padding-bottom: clamp(5rem, 16vh, 9rem);
  }

  .actions {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
</style>
