---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Page not found — CodeFuse Solutions"
  description="That page doesn't exist. CodeFuse Solutions builds custom software for complex, niche problems."
>
  <Header />

  <main class="wrap not-found">
    <h1 class="display">Nothing here.</h1>
    <p class="lede">
      That page doesn&rsquo;t exist — but if your problem is the kind nothing
      off the shelf can solve, you&rsquo;re in the right place.
    </p>
    <div class="actions">
      <a class="text-link" href="/">Back to the studio</a>
      <a class="text-link" href="mailto:contact@codefusesolutions.com">contact@codefusesolutions.com</a>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .not-found {
    padding-top: clamp(5rem, 18vh, 11rem);
    padding-bottom: clamp(6rem, 20vh, 12rem);
    display: grid;
    gap: 2rem;
  }

  .actions {
    display: flex;
    gap: 2.25rem;
    flex-wrap: wrap;
  }
</style>
