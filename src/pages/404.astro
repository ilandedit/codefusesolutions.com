---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="This page doesn't fit — CodeFuse Solutions"
  description="That page doesn't exist. CodeFuse Solutions builds custom software for complex, niche problems."
>
  <Header />

  <main class="wrap not-found grid-stage">
    <div class="tilt-card">
      <h1 class="display">This page doesn&rsquo;t fit.</h1>
      <p class="body-copy">
        It&rsquo;s not part of the site — but pages that don&rsquo;t fit are
        sort of our thing. If your problem is one of them, you&rsquo;re in the
        right place.
      </p>
      <div class="actions">
        <a class="text-link label" href="/">Back to the site</a>
        <a class="text-link label" href="/#contact">Contact</a>
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .not-found {
    padding-top: clamp(4rem, 16vh, 10rem);
    padding-bottom: clamp(5rem, 18vh, 11rem);
    display: grid;
    justify-items: start;
  }

  /* The 404 is the whole page's misfit: one tilted plate. */
  .tilt-card {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: var(--plate-shadow);
    padding: clamp(1.75rem, 5vw, 3.5rem);
    rotate: -2deg;
    max-width: 40rem;
    transition: rotate 200ms var(--ease-out-expo);
  }

  .tilt-card:hover {
    rotate: 0deg;
  }

  .actions {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }
</style>
