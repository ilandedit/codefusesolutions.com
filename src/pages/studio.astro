---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Band from '../components/Band.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/studio/derrick-wengerd.jpg';
---

<Base
  title="Studio — CodeFuse Solutions"
  description="Who CodeFuse Solutions is and how we work: understand first, build precisely, stand behind it."
>
  <Header />

  <main>
    <!-- The founder block: the portrait with a navy panel laid over its
         corner, the way a caption card sits on a print. -->
    <section class="founder">
      <Image
        class="portrait"
        src={portrait}
        alt="Derrick Wengerd, founder of CodeFuse Solutions"
        widths={[400, 754]}
        sizes="(max-width: 860px) 100vw, 48vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="card">
        <p class="label card-label">The studio</p>
        <h1 class="display card-title">Small on purpose.</h1>
        <p>
          CodeFuse Solutions is an independent software studio. We deliberately
          limit the number of clients we take on so that we can ensure every
          engagement gets the attention and intention it needs, from the first
          conversation, all the way to the shipped system.
        </p>
        <p>
          This studio is founder run. You talk with and work directly with me
          and you get access to a decade of software development expertise.
          There is no account layer between the conversation and the work, and
          I only take on projects that we can do exceptionally well.
          Let&rsquo;s have a conversation!
        </p>
        <p class="label sig">Derrick Wengerd · Founder</p>
      </div>
    </section>

    <section class="wrap section">
      <div class="section-head" data-reveal>
        <h2 class="headline">How we work</h2>
      </div>
      <div class="steps">
        <div class="step" data-reveal>
          <p class="label">01 — Understand</p>
          <h3 class="title">The conversations come first</h3>
          <p class="body-copy">
            We always start with a conversation with the people that matter,
            you. We discuss the problem you&rsquo;re trying to solve, the
            process of your business, your constraints and challenges you face.
            We don&rsquo;t start to build before we genuinely understand.
          </p>
        </div>
        <div class="step" data-reveal>
          <p class="label">02 — Build</p>
          <h3 class="title">Built precisely for you</h3>
          <p class="body-copy">
            We hand build our solutions, and tailor them to our customers
            needs. We keep the scope honest, and we keep you at the wheel so
            you can make decisions and help shape the solution as we work.
          </p>
        </div>
        <div class="step" data-reveal>
          <p class="label">03 — Support</p>
          <h3 class="title">We stay reachable after launch</h3>
          <p class="body-copy">
            We ship software that we&rsquo;re prepared to live with, because a
            custom system requires a relationship, not just a contract you sign
            and never hear from us again.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Band
    heading="Think we might fit?"
    copy="Tell us what you're up against. We'll tell you honestly whether we're the right studio for it."
    cta="Get in touch"
    href="/contact/"
  />

  <Footer />
</Base>

<style>
  .founder {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
    max-width: 1400px;
    margin-inline: auto;
    padding: clamp(1rem, 4vh, 2.5rem) clamp(1rem, 2.6vw, 2.5rem) 0;
  }

  .portrait {
    grid-column: 1 / span 6;
    grid-row: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .card {
    grid-column: 6 / -1;
    grid-row: 1;
    z-index: 1;
    margin-top: clamp(3rem, 7vw, 6rem);
    padding: clamp(2rem, 4.5vw, 4.25rem);
    background: var(--navy);
    color: rgba(255, 255, 255, 0.9);
    display: grid;
    gap: 1.25rem;
  }

  .card-label {
    color: #fff;
  }

  .card-title {
    color: #fff;
    font-size: clamp(2.25rem, 4.4vw, 3.5rem);
    margin-bottom: 0.5rem;
  }

  .sig {
    margin-top: 0.5rem;
    color: #fff;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.75rem, 4vw, 3.5rem);
  }

  .step {
    display: grid;
    gap: 0.625rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }

  .step .body-copy {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .founder {
      display: block;
      padding-inline: var(--inset);
    }

    .card {
      margin-top: 0;
    }

    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
