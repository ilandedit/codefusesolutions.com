---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Band from '../components/Band.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/studio/derrick-wengerd.jpg';
---

<Base
  title="Studio — CodeFuse Solutions"
  description="Who CodeFuse Solutions is and how we work: understand first, build precisely, stand behind it."
>
  <Header />

  <main>
    <section class="wrap page-head">
      <p class="label">The studio</p>
      <h1 class="display">Small on purpose.</h1>
      <p class="lede">
        CodeFuse Solutions is an independent software studio. We deliberately
        limit the number of clients we take on so that we can ensure every
        engagement gets the attention and intention it needs, from the first
        conversation, all the way to the shipped system.
      </p>
    </section>

    <section class="wrap section">
      <div class="founder" data-reveal>
        <Image
          class="avatar"
          src={portrait}
          alt="Derrick Wengerd, founder of CodeFuse Solutions"
          width={200}
          height={200}
          densities={[1, 2]}
          loading="eager"
        />
        <div>
          <p class="lede founder-copy">
            This studio is founder run. You talk with and work directly with me
            and you get access to a decade of software development expertise.
            There is no account layer between the conversation and the work,
            and I only take on projects that we can do exceptionally well.
            Let&rsquo;s have a conversation!
          </p>
          <p class="small sig">Derrick Wengerd · Founder</p>
        </div>
      </div>
    </section>

    <section class="wrap section">
      <div class="section-head" data-reveal>
        <h2 class="headline">How we work</h2>
      </div>
      <div class="steps" data-reveal>
        <div class="step s1">
          <p class="label stepn">01 — Understand</p>
          <h3 class="title">The conversation comes first</h3>
          <p class="body-copy">
            We start with how your business actually works: the process, the
            constraints, the edge cases that make your problem yours. Nothing
            gets built until it&rsquo;s genuinely understood.
          </p>
        </div>
        <div class="step s2">
          <p class="label stepn">02 — Build</p>
          <h3 class="title">Built precisely, explained plainly</h3>
          <p class="body-copy">
            Scope stays honest and decisions get explained in language you can
            act on. You see the system as it takes shape, not at the end.
          </p>
        </div>
        <div class="step s3">
          <p class="label stepn">03 — Stand behind it</p>
          <h3 class="title">We stay reachable after launch</h3>
          <p class="body-copy">
            We ship software we&rsquo;re prepared to live with, because a custom
            system is a relationship, not a handoff.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Band
    heading="Think we might fit?"
    copy="Tell us what you're up against. We'll tell you honestly whether we're the right studio for it."
    cta="Get in touch"
    href="/contact/"
  />

  <Footer />
</Base>

<style>
  .founder {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    border: 2px solid var(--card);
    box-shadow: 0 0 0 1px var(--line);
  }

  .founder-copy {
    max-width: 56ch;
    color: var(--ink);
  }

  .sig {
    margin-top: 1rem;
    color: var(--copper);
    font-weight: 600;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }

  .step {
    background: var(--card);
    border-right: 1px solid var(--line);
    padding: 1.75rem 1.5rem;
    position: relative;
  }

  .step:last-child {
    border-right: 0;
  }

  .step::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
  }

  /* the one gradient in the system: listening becoming building */
  .s1::before {
    background: var(--copper);
  }

  .s2::before {
    background: linear-gradient(90deg, var(--copper), var(--navy));
  }

  .s3::before {
    background: var(--navy);
  }

  .stepn {
    color: var(--mute);
    margin-bottom: 0.875rem;
  }

  .step .title {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .step {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .step:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 640px) {
    .founder {
      grid-template-columns: 1fr;
    }
  }
</style>
